      },
      {
        "kind": "text",
        "x": 1,
        "y": 3.1,
        "w": 11.3,
        "h": 0.7,
        "text": "• R closer to thermal → α < 0.5 → greater thermal contribution.",
        "size": 21,
        "color": "#183249",
        "bold": false,
        "align": "left"
      },
      {
        "kind": "rect",
        "x": 1,
        "y": 4.15,
        "w": 11.3,
        "h": 0.75,
        "color": "#dcebf0"
      },
      {
        "kind": "text",
        "x": 1.2,
        "y": 4.33,
        "w": 10.9,
        "h": 0.5,
        "text": "Fused image = α × Visible + (1 − α) × Thermal",
        "size": 25,
        "color": "#087d94",
        "bold": true,
        "align": "center"
      },
      {
        "kind": "text",
        "x": 1,
        "y": 5.15,
